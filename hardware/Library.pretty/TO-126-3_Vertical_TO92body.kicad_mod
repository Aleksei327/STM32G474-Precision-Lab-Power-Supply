(footprint "TO-126-3_Vertical_TO92body"
	(version 20260206)
	(generator "kicad-footprint-generator")
	(layer "F.Cu")
	(descr "Pads of a vertical TO-126, but the part actually fitted is a small TO-92 with its leads bent into line (pitch 2.28 mm). Used for the TL431 and the current-backstop transistor: bigger pads are easier to hand-solder and to etch at home. 3D model is TO-92 inline so the render matches reality. Pad 1 = emitter/REF, pad 2 = collector/anode, pad 3 = base/cathode - bend the legs to match!")
	(tags "TO-126-3 Vertical RM 2.28mm")
	(property "Reference" "REF**"
		(at 2.28 -2.95 0)
		(layer "F.SilkS")
