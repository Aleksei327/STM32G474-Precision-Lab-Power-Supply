(footprint "TO-92_in_TO-126_pads_CBE"
	(version 20260206)
	(generator "kicad-footprint-generator")
	(layer "F.Cu")
	(descr "TO-92 transistor dropped into TO-126-sized pads (easier to solder and to etch at home). PAD NUMBERS ARE REASSIGNED so a BC547/BC548-style TO-92 goes straight in with NO crossed legs: along +X the pads are COLLECTOR (pad 2), BASE (pad 3), EMITTER (pad 1) - that is the leg order of a BC548 seen from its flat side. Letters C/B/E are on the silkscreen. Drills 0.6 mm pilots. Do NOT use for the TL431 - it needs the other numbering (see TO-126-3_Vertical_TO92body).")
	(tags "TO-126-3 Vertical RM 2.28mm")
