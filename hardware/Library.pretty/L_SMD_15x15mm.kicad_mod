(footprint "L_SMD_15x15mm"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Shielded SMD power inductor 15x15mm, 2 terminals (user's 68uH). Pads 4x7mm, centres +/-5.5mm")
	(tags "inductor smd shielded")
	(attr smd)
	(property "Reference" "REF**" (at 0 -9 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "68uH" (at 0 9 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(pad "1" smd rect (at -5.5 0) (size 4 7) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "2" smd rect (at 5.5 0) (size 4 7) (layers "F.Cu" "F.Paste" "F.Mask"))
	(fp_line (start -7.5 -7.5) (end 7.5 -7.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start 7.5 -7.5) (end 7.5 7.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start 7.5 7.5) (end -7.5 7.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -7.5 7.5) (end -7.5 -7.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(model "${KIPRJMOD}/Library.3dshapes/L_SMD_15x15mm.wrl"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
