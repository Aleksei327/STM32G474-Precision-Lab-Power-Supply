(footprint "INA228_Module_1x08"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Adafruit-style INA228 breakout, 25.4x20.3 mm, rounded corners. Pad numbers = INA228 chip pins (VIN=6 GND=7 SCL=5 SDA=4 VBUS=8 VIN-=9 VIN+=10 ALRT=3). Bottom row = 1x8 2.54mm header; TOP row = the 3.5mm terminal block Vin-(9)/VBus(8)/Vin+(10) - same pad numbers, so the same nets: solder to whichever is convenient. Two NPTH mounting holes at the top corners are 0.6mm PILOTS - enlarge to 2.3-2.4 mm for M2 screws if the module is to be bolted down. On the module itself: R015 shunt MUST be removed (our constantan staple is the shunt), VBUS-VIN+ jumper open, Addr jumpers open (0x40).")
	(tags "INA228 module breakout")
	(attr through_hole)
	(duplicate_pad_numbers_are_jumpers yes)
